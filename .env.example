# Set server-side values in Vercel > Project > Settings > Environment Variables.
# Never prefix credentials with VITE_ or commit a populated .env file.
SUPABASE_URL=https://tdzidbkqieqlyuxgoydk.supabase.co
# Accepts a legacy anon JWT or a new sb_publishable_... API key.
# Keep the existing variable name for compatibility. Do not use service_role.
SUPABASE_ANON_KEY=

# Optional: live YouTube count and newest uploads. Links work without these.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=JXXMALMUSIK

# Optional: authorized professional Instagram account, via Instagram Login.
# Use a long-lived token with instagram_business_basic for @jxxmalmusik.
# Set these in Vercel, never in the browser or a chat message.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=v24.0

# Optional: Soundcharts production API access for Spotify monthly listeners.
# Spotify's standard Web API does not expose this metric.
# Without access, the site labels its verified saved count with its date.
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=

# Optional fallback only: verified previews already work without these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN is no longer needed. The now-playing UI is removed.
